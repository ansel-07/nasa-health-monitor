  "muscle_atrophy": {
    "name": "Muscle atrophy",
    "description": "Monitor muscle strength, size, power, endurance, tone and stiffness against a comparable personal pre-flight baseline. Statistical changes request review and do not diagnose atrophy. Sudden weakness or failure of a critical task requires medical assessment without waiting for maximal tests or repeat measurements.",
    "hrp_risk": "Risk of Reduced Physical Performance Capabilities Due to Reduced Muscle Size, Strength, and Endurance (Muscle Risk)",
    "confirm_wait_min": 2,
    "tutorial_bar_full_days": 14,
    "protocol": "protocols/muscle_atrophy.json",
    "source": "Criteria: guia_breve_umbrales_atrofia_SANS (1).pdf (2026-11-14), p. 1 and p. 2 clinical-priority note. HRP risk: https://www.nasa.gov/directorates/esdmd/hhp/muscle-risk/ . Repeat timing [P]: 2 minutes is an estimated prototype minimum based on rest between isometric strength trials: https://stacks.cdc.gov/view/cdc/9182/cdc_9182_DS1.pdf , printed p. 14, Rest Period Length. Rest must be extended if fatigue remains. This is not a validated atrophy confirmation interval for all indicators, a treatment, or a NASA-measured recovery time; extrapolation to a per-problem demo countdown is a prototype choice authorized by Edu. Do not perform maximal tests with pain or delay medical assessment for sudden weakness/critical-task failure. Level/state definitions: https://github.com/ansel-07/nasa-health-monitor/issues/43#issuecomment-6879885382 . Numerical concern findings request priority medical review but do not establish medical urgency. Protocol red flags can escalate a confirmed episode. Separately, configured subjective alarms display immediate medical-action guidance in Check-in without waiting for numerical confirmation and remain visible on the Main Menu until resolved (AGENTS.md 5.6). Alarm reports do not themselves open or confirm an episode; pre-confirmation clinical episode entry remains a separate contract decision. No gravity multiplier or count-of-concern escalation is supported. Tutorial activity-bar timing [P]: 14 mission days is an explicitly synthetic non-clinical demo practice timer authorized by Edu for #98; not a medical surveillance, treatment, confirmation or validated skills-retention interval. Basis: docs/CHECK_IN_INTERVALS.md.",
    "symptoms": {
      "muscle_strength": {
        "name": "Muscle force reduction",
        "levels": [
          {
            "level": "concern",
            "when": {
              "indicator": "muscle_strength",
              "metric": "baseline_fraction",
              "below": 0.8
            }
          },
          {
            "level": "watch",
            "when": {
              "all": [
                {
                  "indicator": "muscle_strength",
                  "metric": "z_score",
                  "at_most": -2
                },
                {
                  "indicator": "muscle_strength",
                  "metric": "baseline_fraction",
                  "at_least": 0.8
                }
              ]
            }
          }
        ]
      },
      "muscle_area": {
        "name": "Muscle size reduction",
        "levels": [
          {
            "level": "concern",
            "when": {
              "indicator": "muscle_area",
              "metric": "z_score",
              "at_most": -3
            }
          },
          {
            "level": "watch",
            "when": {
              "indicator": "muscle_area",
              "metric": "z_score",
              "above": -3,
              "at_most": -2
            }
          }
        ]
      },
      "muscle_power": {
        "name": "Muscle power reduction",
        "levels": [
          {
            "level": "concern",
            "when": {
              "indicator": "muscle_power",
              "metric": "z_score",
              "at_most": -3
            }
          },
          {
            "level": "watch",
            "when": {
              "indicator": "muscle_power",
              "metric": "z_score",
              "above": -3,
              "at_most": -2
            }
          }
        ]
      },
      "muscle_endurance": {
        "name": "Muscle endurance reduction",
        "levels": [
          {
            "level": "concern",
            "when": {
              "indicator": "muscle_endurance",
              "metric": "z_score",
              "at_most": -3
            }
          },
          {
            "level": "watch",
            "when": {
              "indicator": "muscle_endurance",
              "metric": "z_score",
              "above": -3,
              "at_most": -2
            }
          }
        ]
      },
      "muscle_tone": {
        "name": "Muscle tone change",
        "levels": [
          {
            "level": "concern",
            "when": {
              "indicator": "muscle_tone",
              "metric": "abs_z_score",
              "at_least": 3
            }
          },
          {
            "level": "watch",
            "when": {
              "indicator": "muscle_tone",
              "metric": "abs_z_score",
              "at_least": 2,
              "below": 3
            }
          }
        ]
      },
      "muscle_stiffness": {
        "name": "Muscle stiffness change",
        "levels": [
          {
            "level": "concern",
            "when": {
              "indicator": "muscle_stiffness",
              "metric": "abs_z_score",
              "at_least": 3
            }
          },
          {
            "level": "watch",
            "when": {
              "indicator": "muscle_stiffness",
              "metric": "abs_z_score",
              "at_least": 2,
              "below": 3
            }
          }
        ]
      }
    },
    "states": [
      {
        "state": "watch",
        "when": {
          "any": [
            {
              "symptom": "muscle_strength",
              "level_at_least": "watch"
            },
            {
              "symptom": "muscle_area",
              "level_at_least": "watch"
            },
            {
              "symptom": "muscle_power",
              "level_at_least": "watch"
            },
            {
              "symptom": "muscle_endurance",
              "level_at_least": "watch"
            },
            {
              "symptom": "muscle_tone",
              "level_at_least": "watch"
            },
            {
              "symptom": "muscle_stiffness",
              "level_at_least": "watch"
            }
          ]
        }
      }
    ]
  },
  "_example": {
    "name": "Example problem (test fixture)",
    "description": "Fake problem used to build and test the engine. Not health content.",
    "hrp_risk": "none",
    "confirm_wait_min": 0,
    "tutorial_bar_full_days": 1,
    "protocol": "protocols/_example.json",
    "triggers": [
      { "severity": "mild", "when": { "indicator": "_example_indicator", "above": 10 } },
      { "severity": "moderate", "when": { "indicator": "_example_indicator", "above": 20 } },
      { "severity": "severe", "when": { "indicator": "_example_indicator", "above": 30 } },
      { "severity": "moderate", "when": { "indicator": "_example_indicator", "above": 5 }, "environments": ["mars"] }
    ],
    "symptoms": {
      "symptom_a": {
        "name": "Example symptom A (test fixture)",
        "levels": [
          { "level": "concern", "when": { "indicator": "_example_indicator", "above": 30 } },
          { "level": "watch", "when": { "indicator": "_example_indicator", "above": 5 }, "environments": ["mars"] },
          { "level": "watch", "when": { "indicator": "_example_indicator", "above": 10 } }
        ]
      },
      "symptom_b": {
        "name": "Example symptom B (test fixture)",
        "levels": [
          { "level": "concern", "when": { "indicator": "_example_indicator_2", "above": 20 } },
          { "level": "watch", "when": { "indicator": "_example_indicator_2", "above": 10 } }
        ]
      }
    },
    "states": [
      { "state": "medical_urgency", "when": { "any": [
        { "count_at_least": 2, "of": [
