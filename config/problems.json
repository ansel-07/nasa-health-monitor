          { "symptom": "symptom_b", "level_at_least": "concern" }
        ] },
        { "all": [ { "symptom": "symptom_a", "level_is": "concern" }, { "environment_in": ["mars"] } ] }
      ] } },
      { "state": "watch", "when": { "count_at_least": 1, "of": [
        { "symptom": "symptom_a", "level_at_least": "watch" },
