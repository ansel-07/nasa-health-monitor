{
  "sans": {
    "name": "Spaceflight eye changes (SANS)",
    "description": "Spaceflight-associated neuro-ocular syndrome (SANS) involves changes inside the eye and in vision. Compare each eye with its own pre-flight reference; findings request review, not a diagnosis. New vision loss, gaps or central distortion need medical assessment without waiting for a repeat measurement.",
    "hrp_risk": "Risk of Spaceflight Associated Neuro-ocular Syndrome (SANS)",
    "confirm_wait_min": 10,
    "tutorial_bar_full_days": 7,
    "protocol": "protocols/sans.json",
    "source": "Criteria: guia_breve_umbrales_atrofia_SANS (1).pdf (2026-11-14), p. 2. HRP risk: https://www.nasa.gov/directorates/esdmd/hhp/risk-of-spaceflight-associated-neuro-ocular-syndrome/ . Repeat timing [P]: 10 minutes is an estimated prototype re-acquisition interval selected under Edu's authorization to use estimates, not a NASA measurement or validated SANS recommendation. Analogy: https://doi.org/10.1371/journal.pone.0221466 , Methods, OCT measurements, reports nine consecutive scans within less than 10 minutes in healthy eyes; it does NOT prescribe a 10-minute wait or establish equivalence to peripapillary TRT, refraction or visual-acuity confirmation. This is a minimum demo countdown, not a follow-up schedule or a reason to delay medical assessment. Level/state definitions: https://github.com/ansel-07/nasa-health-monitor/issues/43#issuecomment-6879885382 . Numerical concern findings request priority medical review but do not establish medical urgency. Protocol red flags can escalate a confirmed episode. Separately, configured subjective alarms display immediate medical-action guidance in Check-in without waiting for numerical confirmation and remain visible on the Main Menu until resolved (AGENTS.md 5.6). Alarm reports do not themselves open or confirm an episode; pre-confirmation clinical episode entry remains a separate contract decision. No gravity multiplier or count-of-concern escalation is supported. Tutorial activity-bar timing [P]: 7 mission days is an explicitly synthetic non-clinical demo practice timer authorized by Edu for #98; not a medical surveillance, treatment, confirmation or validated skills-retention interval. Basis: docs/CHECK_IN_INTERVALS.md.",
    "symptoms": {
      "peripapillary_trt_left": {
        "name": "Retinal thickening (left eye)",
        "levels": [
          {
            "level": "concern",
            "when": {
              "indicator": "peripapillary_trt_left",
              "metric": "baseline_delta",
              "at_least": 55
            }
          },
          {
            "level": "watch",
            "when": {
              "indicator": "peripapillary_trt_left",
              "metric": "baseline_delta",
              "at_least": 20,
              "below": 55
            }
          }
        ]
      },
      "optic_disc_edema_grade_left": {
        "name": "Optic disc edema (left eye)",
        "levels": [
          {
            "level": "concern",
            "when": {
              "indicator": "optic_disc_edema_grade_left",
              "metric": "raw",
              "at_least": 1
            }
          }
        ]
      },
      "refraction_left": {
        "name": "Positive refractive shift (left eye)",
        "levels": [
          {
            "level": "watch",
            "when": {
              "indicator": "refraction_left",
              "metric": "baseline_delta",
              "above": 0.5
            }
          }
        ]
      },
      "visual_acuity_left": {
        "name": "Corrected visual acuity change (left eye)",
        "levels": [
          {
            "level": "concern",
            "when": {
              "indicator": "visual_acuity_left",
              "metric": "z_score",
              "at_least": 3
            }
          },
          {
            "level": "watch",
            "when": {
              "indicator": "visual_acuity_left",
              "metric": "z_score",
              "at_least": 2,
              "below": 3
            }
          }
        ]
      },
      "peripapillary_trt_right": {
        "name": "Retinal thickening (right eye)",
        "levels": [
          {
            "level": "concern",
            "when": {
              "indicator": "peripapillary_trt_right",
              "metric": "baseline_delta",
              "at_least": 55
            }
          },
          {
            "level": "watch",
            "when": {
              "indicator": "peripapillary_trt_right",
              "metric": "baseline_delta",
              "at_least": 20,
              "below": 55
            }
          }
        ]
      },
      "optic_disc_edema_grade_right": {
        "name": "Optic disc edema (right eye)",
        "levels": [
          {
            "level": "concern",
            "when": {
              "indicator": "optic_disc_edema_grade_right",
              "metric": "raw",
              "at_least": 1
            }
          }
        ]
      },
      "refraction_right": {
        "name": "Positive refractive shift (right eye)",
        "levels": [
          {
            "level": "watch",
            "when": {
              "indicator": "refraction_right",
              "metric": "baseline_delta",
              "above": 0.5
            }
          }
        ]
      },
      "visual_acuity_right": {
        "name": "Corrected visual acuity change (right eye)",
        "levels": [
          {
            "level": "concern",
            "when": {
              "indicator": "visual_acuity_right",
              "metric": "z_score",
              "at_least": 3
            }
          },
          {
            "level": "watch",
            "when": {
              "indicator": "visual_acuity_right",
              "metric": "z_score",
              "at_least": 2,
              "below": 3
            }
          }
        ]
      }
    },
    "states": [
      {
        "state": "watch",
        "when": {
          "any": [
            {
              "symptom": "peripapillary_trt_left",
              "level_at_least": "watch"
            },
            {
              "symptom": "optic_disc_edema_grade_left",
              "level_at_least": "watch"
            },
            {
              "symptom": "refraction_left",
              "level_at_least": "watch"
            },
            {
              "symptom": "visual_acuity_left",
              "level_at_least": "watch"
            },
            {
              "symptom": "peripapillary_trt_right",
              "level_at_least": "watch"
            },
            {
              "symptom": "optic_disc_edema_grade_right",
              "level_at_least": "watch"
            },
            {
              "symptom": "refraction_right",
              "level_at_least": "watch"
            },
            {
              "symptom": "visual_acuity_right",
              "level_at_least": "watch"
            }
          ]
        }
      }
    ]
